<Window x:Class="AirVM.UI.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AirVM.UI.Controls"
        Title="AirVM Console" Width="920" Height="640" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#1A1A2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#242438">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Button x:Name="StartStopBtn" Content="▶ Start" Click="ToggleStartStop" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="PauseBtn" Content="⏸ Pause" Click="TogglePause" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12" IsEnabled="False"/>
                <Button Content="💿 Media" Click="ShowMediaMenu" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="CaptureBtn" Content="📷 Capture" Click="TakeScreenshot" Padding="12,6" Margin="0,0,8,0"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12" IsEnabled="False"/>
                <Button Content="⛶ Full" Click="ToggleFullscreen" Padding="12,6"
                        Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <TextBlock x:Name="ToolbarVMName" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Bar -->
        <Border Grid.Row="1" Background="#1F1F30">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Button x:Name="TabDisplay" Content="🖥 Display" Click="SwitchTab" Tag="0"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Padding="12,4" Margin="0,3,4,3" Cursor="Hand" FontSize="11"/>
                <Button x:Name="TabLog" Content="📋 Log" Click="SwitchTab" Tag="1"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="12,4" Margin="0,3,4,3" Cursor="Hand" FontSize="11"/>
                <Button x:Name="TabSerial" Content="🔌 Serial" Click="SwitchTab" Tag="2"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="12,4" Margin="0,3,0,3" Cursor="Hand" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Content Area (tab panels) -->
        <Grid Grid.Row="2">
            <!-- Display Tab (VNC Viewer) -->
            <Grid x:Name="DisplayPanel" Visibility="Visible">
                <controls:VNCViewerControl x:Name="VNCViewer"/>
            </Grid>

            <!-- Log Tab -->
            <TextBox x:Name="LogView" Visibility="Collapsed" IsReadOnly="True" Background="#1A1A2E" Foreground="#B3F0B3"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12"/>

            <!-- Serial Tab -->
            <controls:SerialTerminalControl x:Name="SerialTerminal" Visibility="Collapsed"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#151528">
            <TextBlock x:Name="StatusBar" Text="Ready" FontSize="10" Foreground="#666"
                       VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- Splash Overlay -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#1A1A2E">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="AirVM" FontSize="72" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock x:Name="SplashSubtitle" Text="Starting virtual machine..." FontSize="14"
                           Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#3B82F6"
                             Background="#333" HorizontalAlignment="Center"/>
                <TextBlock Text="Version 1.0" FontSize="10" Foreground="#444"
                           HorizontalAlignment="Center" Margin="0,40,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
