<Window x:Class="AirVM.UI.ConfigWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Virtual Machine" Width="780" Height="560" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Mode Switcher -->
                <Border DockPanel.Dock="Top" CornerRadius="6" Background="#E8E8E8" Margin="12,12,12,8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ModeSimple" Content="Simple" Click="Mode_Click" Tag="0"
                                Background="Transparent" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"/>
                        <Button x:Name="ModeStandard" Content="Standard" Click="Mode_Click" Tag="1"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"/>
                        <Button x:Name="ModeAdvanced" Content="Advanced" Click="Mode_Click" Tag="2"
                                Background="Transparent" BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Step List -->
                <ListBox x:Name="StepList" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"
                         SelectionChanged="StepList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="16,8">
                                <Ellipse Width="8" Height="8" Fill="#CCC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <Border Grid.Column="1" Grid.Row="0" Padding="24">
            <Grid x:Name="ContentArea">

                <!-- Step 0: Basic -->
                <StackPanel x:Name="StepBasic" Visibility="Visible">
                    <TextBlock Text="Basic Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Virtual Machine Name" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="VMNameBox" Padding="8,6" FontSize="14" BorderBrush="#DDD" Margin="0,0,0,16"/>
                    <TextBlock Text="Architecture" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ArchCombo" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
                    <TextBlock Text="Machine Type" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MachineTypeCombo" Padding="8,6" FontSize="13" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Step 1: Hardware -->
                <StackPanel x:Name="StepHardware" Visibility="Collapsed">
                    <TextBlock Text="Hardware" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="CPU Model" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CpuCombo" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
                    <TextBlock Text="CPU Cores" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CoresCombo" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
                    <TextBlock Text="Memory" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MemoryBox" Width="100" Padding="8,6" FontSize="13"/>
                        <ComboBox x:Name="MemoryUnitCombo" Width="80" Padding="8,6" FontSize="13" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: Storage -->
                <StackPanel x:Name="StepStorage" Visibility="Collapsed">
                    <TextBlock Text="Storage" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Disk Size" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox x:Name="DiskSizeBox" Width="80" Padding="8,6" FontSize="13"/>
                        <ComboBox x:Name="DiskUnitCombo" Width="80" Padding="8,6" FontSize="13" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Boot ISO (optional)" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox x:Name="BootISOBox" Width="300" Padding="8,6" FontSize="12" IsReadOnly="True"/>
                        <Button Content="Browse..." Click="BrowseBootISO" Padding="12,6" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="CD-ROM Image (optional)" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CDROMBox" Width="300" Padding="8,6" FontSize="12" IsReadOnly="True"/>
                        <Button Content="Browse..." Click="BrowseCDROM" Padding="12,6" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: Network -->
                <StackPanel x:Name="StepNetwork" Visibility="Collapsed">
                    <TextBlock Text="Network" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Network Mode" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="NetworkModeCombo" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
                    <!-- Modem Options (Advanced only) -->
                    <StackPanel x:Name="ModemPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <CheckBox x:Name="ModemCheck" Content="Enable Virtual Modem (dial-up)" FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                            <TextBlock Text="Modem Speed:" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModemSpeedCombo" Width="100" Padding="6,4" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Terminal (Advanced only) -->
                    <CheckBox x:Name="TerminalCheck" Content="Enable Terminal (serial port)" FontSize="12"
                              Visibility="Collapsed" Margin="0,0,0,12"/>
                    <!-- Unity Mode (Standard+) -->
                    <CheckBox x:Name="UnityCheck" Content="Enable Unity/Fusion Mode (VM apps on host desktop)" FontSize="12"
                              Visibility="Collapsed"/>
                </StackPanel>

                <!-- Step 4: Display -->
                <StackPanel x:Name="StepDisplay" Visibility="Collapsed">
                    <TextBlock Text="Display" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Display Backend" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DisplayCombo" Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
                    <CheckBox x:Name="AudioCheck" Content="Enable Audio" FontSize="12" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="USBCheck" Content="Enable USB" FontSize="12" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AccelCheck" Content="Enable Hardware Acceleration" FontSize="12" IsChecked="True"/>
                </StackPanel>

                <!-- Step 5: Summary -->
                <ScrollViewer x:Name="StepSummary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Summary" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource CardBorder}">
                            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#333" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                        <TextBlock Text="Notes (optional)" FontSize="12" Foreground="#666" Margin="0,12,0,4"/>
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="80" Padding="8,6" FontSize="12"
                                 TextWrapping="Wrap" BorderBrush="#DDD"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Buttons -->
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button x:Name="BackBtn" Content="← Back" Click="Back_Click" Padding="16,8" Margin="0,0,8,0"
                        BorderBrush="#DDD" Background="White" IsEnabled="False"/>
                <Button x:Name="NextBtn" Content="Next →" Click="Next_Click" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" BorderBrush="#DDD" Background="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
