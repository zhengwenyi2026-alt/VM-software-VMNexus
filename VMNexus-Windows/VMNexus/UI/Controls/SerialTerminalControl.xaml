<UserControl x:Class="AirVM.UI.Controls.SerialTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141420">
    <DockPanel>
        <!-- Input Field -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="#1A1A2E" BorderBrush="#333" BorderThickness="0,1,0,0">
            <TextBox x:Name="InputBox" Background="#1A1A2E" Foreground="#B3F0B3" FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" Padding="8,4" KeyDown="InputBox_KeyDown"
                     Tag="Type command and press Enter...">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Type command and press Enter..." Foreground="#555" Margin="8,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- Terminal Output -->
        <TextBox x:Name="TerminalOutput" IsReadOnly="True" Background="#141420" Foreground="#B3F0B3"
                 FontFamily="Consolas" FontSize="12" BorderThickness="0"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Padding="8"
                 TextWrapping="NoWrap"/>
    </DockPanel>
</UserControl>
