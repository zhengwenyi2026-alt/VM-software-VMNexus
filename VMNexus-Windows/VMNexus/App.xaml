<Application x:Class="AirVM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme Colors -->
            <Color x:Key="PrimaryColor">#2563EB</Color>
            <Color x:Key="SidebarColor">#F5F5F5</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="DarkBgColor">#1A1A2E</Color>
            <Color x:Key="ToolbarColor">#242438</Color>
            <Color x:Key="SuccessColor">#40BF60</Color>
            <Color x:Key="WarningColor">#F5A623</Color>
            <Color x:Key="ErrorColor">#E63946</Color>
            <Color x:Key="InfoColor">#3B82F6</Color>

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}"/>
            <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

            <!-- Card Style -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Status Badge Style -->
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="MinWidth" Value="60"/>
            </Style>

            <!-- Primary Button Style -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
